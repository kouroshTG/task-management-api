APP_NAME=Task Management API
APP_VERSION=0.1.0
DEBUG=false

POSTGRES_DB=task_management
POSTGRES_USER=task_user
POSTGRES_PASSWORD=replace-with-a-secure-password

DATABASE_URL=postgresql+psycopg://task_user:replace-with-a-secure-password@localhost:5432/task_management

DATABASE_URL_DOCKER=postgresql+psycopg://task_user:replace-with-a-secure-password@db:5432/task_management

SECRET_KEY=replace-with-a-secure-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
